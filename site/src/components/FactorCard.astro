---
/**
 * One factor as a ledger row: name, weight, bar, score and a one-line summary of the
 * inputs that made it, expanding to every input's raw value, curve and points.
 */
import { factorBlurbs, factorLabels, type MethodologyInput, type Score } from "../lib/data";
import { formatValue, inputSummary, label } from "../lib/format";

interface Props { factor: string; weight: number; score: Pick<Score, "factor_scores" | "inputs">; inputs: MethodologyInput[]; tone?: "readiness" | "momentum"; open?: boolean; }
const { factor, weight, score, inputs, tone = "readiness", open = false } = Astro.props;
const fs = score.factor_scores[factor];
const summary = inputSummary(score, inputs);
---
<details class:list={["factor", `tone-${tone}`]} open={open}>
  <summary>
    <span class="name">{factorLabels[factor] ?? factor}</span>
    <span class="weight mono">{Math.round(weight * 100)}%</span>
    <span class="bar" aria-hidden="true"><span style={`width:${fs === null || fs === undefined ? 0 : Math.round(fs * 100)}%`}></span></span>
    <span class="fs mono">{fs === null || fs === undefined ? "n/a" : Math.round(fs * 100)}</span>
    <span class="sum">{fs === null || fs === undefined ? "no usable inputs" : summary}</span>
  </summary>
  <p class="muted small blurb">{factorBlurbs[factor]}</p>
  <div class="table-wrap">
    <table class="inputs">
      <thead><tr><th>Input</th><th class="num">Value</th><th class="num">Normalised</th><th class="num">Points</th><th>Period · source</th></tr></thead>
      <tbody>
        {inputs.map((inp) => {
          const i = score.inputs[inp.name];
          const metricName = inp.metric;
          return (
            <tr>
              <td>{label(metricName)}{inp.curve && <><br /><span class="muted small">{inp.curve}</span></>}</td>
              <td class="num">
                {i?.status === "usable" || (inp.context_only && i?.value !== null && i?.value !== undefined && !i?.suppressed) ? formatValue(metricName, i.value) :
                 i?.status === "suppressed" ? <a href="/methodology#suppression">not available at this sample size</a> :
                 i?.status === "not_applicable" ? <span class="muted">not applicable</span> :
                 <a href="/methodology#missing">not available</a>}
              </td>
              <td class="num">{inp.context_only ? <span class="muted">benchmark</span> : i?.normalised === null || i?.normalised === undefined ? "—" : i.normalised.toFixed(2)}</td>
              <td class="num">{i?.contribution === null || i?.contribution === undefined ? "—" : i.contribution.toFixed(1)}</td>
              <td class="small muted mono">{i?.period ?? ""}{i?.source_id ? ` · ${i.source_id}` : ""}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</details>
