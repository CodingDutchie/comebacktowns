---
/**
 * The momentum chip: direction, not rank. "▲ RISING 74", or "NO LABEL · 2 OF 4" when the
 * town lacks the inputs for one, or "NOT SCORED" when there is no momentum run at all.
 */
import { momentumLabels, type Momentum } from "../lib/data";
import { momentumUsage } from "../lib/format";

interface Props { m?: Momentum | null; big?: boolean; }
const { m, big = false } = Astro.props;
const arrow: Record<string, string> = { rising: "▲", steady: "▶", fading: "▼" };
const usage = m ? momentumUsage(m) : null;
---
{m && m.label ? (
  <span class:list={["momentum", m.label, { big }]} aria-label={`Momentum ${momentumLabels[m.label] ?? m.label}, ${Math.round(m.momentum)} of 100`}>
    {`${arrow[m.label] ?? ""} ${(momentumLabels[m.label] ?? m.label).toUpperCase()} ${Math.round(m.momentum)}`}
  </span>
) : m ? (
  <span class:list={["momentum", "none", { big }]} title="Fewer inputs than a label needs">{`NO LABEL · ${usage!.used} OF ${usage!.total}`}</span>
) : (
  <span class:list={["momentum", "none", { big }]}>NOT SCORED</span>
)}
