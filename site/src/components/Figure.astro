---
/**
 * One headline number with its source and period, and an optional comparison line. A
 * suppressed value says so and links to the explanation; a missing value says so too.
 * Never a blank, never a zero standing in for "unknown".
 */
import { sourceShort, type MetricEntry } from "../lib/data";
import { formatValue, label } from "../lib/format";

interface Props { name: string; entry?: MetricEntry; note?: string; label?: string; }
const { name, entry, note, label: heading } = Astro.props;
const meta = [entry ? `${sourceShort(entry.source_id)} ${entry.period}` : "no source yet", note].filter(Boolean).join(" · ");
---
<div class="card figure">
  <span class="label mono">{heading ?? label(name)}</span>
  {entry && entry.value !== null && !entry.suppressed ? (
    <span class="value">{formatValue(name, entry.value)}</span>
  ) : entry && entry.suppressed ? (
    <span class="value na"><a href="/methodology#suppression">not available at this sample size</a></span>
  ) : (
    <span class="value na"><a href="/methodology#missing">not available</a></span>
  )}
  <span class="meta">{meta}</span>
</div>
