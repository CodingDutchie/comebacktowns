---
import Base from "../../layouts/Base.astro";
import Grade from "../../components/Grade.astro";
import Momentum from "../../components/Momentum.astro";
import { band, meta, momentum } from "../../lib/data";
import { population, score1 } from "../../lib/format";
import { rankings, type Ranking } from "../../lib/rankings";
import { itemList, year } from "../../lib/seo";

export function getStaticPaths() {
  return rankings.map((r) => ({ params: { ranking: r.slug }, props: { ranking: r } }));
}
const { ranking } = Astro.props as { ranking: Ranking };
const rows = ranking.rows();
const fmtPrimary = ranking.fmt;
const title = `${ranking.title} (${year})`;
const description = `${ranking.description} ${rows.length} of ${meta.town_count} New York towns qualify.`;
const ld = itemList(`${ranking.title}, ${meta.site.SITE_NAME} ${year}`, rows.map((r) => ({ name: `${r.town.name}, NY`, path: `/town/${r.town.slug}` })), ranking.description);
---
<Base title={title} description={description} jsonLd={ld} crumbs={[{ name: "Rankings", path: "/rankings" }, { name: ranking.title, path: `/rankings/${ranking.slug}` }]}>
  <div class="wrap">
    <p class="eyebrow" style="margin:0">Ranking</p>
    <h1>{ranking.title}</h1>
    <p class="lede">{ranking.description} Figures as published {meta.generated_at.slice(0, 10)}.</p>
    <p class="chips">{rankings.filter((r) => r.slug !== ranking.slug).map((r) => <a href={`/rankings/${r.slug}`}>{r.title}</a>)}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Town</th><th>Region</th><th>Band</th><th>Grade</th><th class="num">{ranking.primaryLabel}</th><th class="num">Readiness</th><th>Momentum</th><th>Note</th></tr></thead>
        <tbody>
          {rows.map((r, i) => (
            <tr>
              <td class="mono muted">{i + 1}</td>
              <td><a class="town" href={`/town/${r.town.slug}`}>{r.town.name}</a> <span class="sub">{r.town.county}</span></td>
              <td class="muted small">{r.town.region}</td>
              <td class="small">{band(r.town)} <span class="muted">({population(r.town.pop_latest)})</span></td>
              <td><Grade grade={r.grade} /></td>
              <td class="num">{fmtPrimary(r.primary)}</td>
              <td class="num">{score1(r.readiness)}</td>
              <td><Momentum m={momentum[r.town.geoid]} /></td>
              <td class="small muted">{r.extra}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small">{rows.length} of {meta.town_count} towns qualify. <a href="/methodology">How the scores work.</a></p>
  </div>
</Base>
