---
import Base from "../../layouts/Base.astro";
import Grade from "../../components/Grade.astro";
import { band, meta } from "../../lib/data";
import { population, score1 } from "../../lib/format";
import { rankings, type Ranking } from "../../lib/rankings";

export function getStaticPaths() {
  return rankings.map((r) => ({ params: { ranking: r.slug }, props: { ranking: r } }));
}
const { ranking } = Astro.props as { ranking: Ranking };
const rows = ranking.rows();
const fmtPrimary = (v: number) =>
  ranking.slug === "price-headroom" ? `${(v * 100).toFixed(0)}%` : ranking.slug === "value-within-an-hour" ? (Number.isNaN(v) ? "n/a" : `${Math.round(v)} min`) : v.toFixed(1);
---
<Base title={ranking.title} description={ranking.description}>
  <h1>{ranking.title}</h1>
  <p class="lede">{ranking.description}</p>
  <p class="small">Other rankings: {rankings.filter((r) => r.slug !== ranking.slug).map((r, i) => <>{i > 0 && " · "}<a href={`/rankings/${r.slug}`}>{r.title}</a></>)}</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>#</th><th>Town</th><th>Region</th><th>Band</th><th>Grade</th><th class="num">{ranking.primaryLabel}</th><th class="num">Readiness</th><th>Note</th></tr></thead>
      <tbody>
        {rows.map((r, i) => (
          <tr>
            <td>{i + 1}</td>
            <td><a href={`/town/${r.town.slug}`}>{r.town.name}</a> <span class="muted small">{r.town.county}</span></td>
            <td class="small">{r.town.region}</td>
            <td class="small">{band(r.town)} <span class="muted">({population(r.town.pop_latest)})</span></td>
            <td><Grade grade={r.grade} /></td>
            <td class="num">{fmtPrimary(r.primary)}</td>
            <td class="num">{score1(r.readiness)}</td>
            <td class="small muted">{r.extra}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted small">{rows.length} of {meta.town_count} towns qualify. <a href="/methodology">How the score works.</a></p>
</Base>
