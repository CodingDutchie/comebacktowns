---
import Base from "../../layouts/Base.astro";
import { rankings } from "../../lib/rankings";
import { year } from "../../lib/seo";
---
<Base title={`New York town rankings (${year})`} description="Rankings of Hudson Valley, Capital Region and Mohawk Valley towns by readiness, momentum, price, distance to New York City, rail access and state downtown awards, from dated public data." crumbs={[{ name: "Rankings", path: "/rankings" }]}>
  <div class="wrap">
    <h1>Rankings</h1>
    <p class="lede">Start with a question. Each ranking is one sentence long and links to every town in it.</p>
    <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))">
      {rankings.map((r) => <a class="card link" href={`/rankings/${r.slug}`}><span class="title">{r.title}</span><span class="muted small">{r.description}</span></a>)}
    </div>
  </div>
</Base>
