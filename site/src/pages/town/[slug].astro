---
import Base from "../../layouts/Base.astro";
import Grade from "../../components/Grade.astro";
import Figure from "../../components/Figure.astro";
import FactorCard from "../../components/FactorCard.astro";
import Momentum from "../../components/Momentum.astro";
import { band, bandKey, meta, methodology, metric, momentum, scores, sourceById, towns, usable, type Town } from "../../lib/data";
import { formatValue, label, momentumMeaning, momentumUsage, population, pct, readinessMeaning, score1 } from "../../lib/format";
import { countyPath, placeLd, regionPath, townDescription, townFacts, townSummary, townTitle } from "../../lib/seo";

export function getStaticPaths() {
  return towns.map((t) => ({ params: { slug: t.slug }, props: { town: t } }));
}
const { town } = Astro.props as { town: Town };
const score = scores[town.geoid];
const mo = momentum[town.geoid];
const m = (name: string) => metric(town.geoid, name);
const peers = towns
  .filter((t) => t.region === town.region && bandKey(t) === bandKey(town) && scores[t.geoid])
  .sort((a, b) => scores[b.geoid].readiness - scores[a.geoid].readiness);
const myRank = peers.findIndex((t) => t.geoid === town.geoid);
const peerRows = [...peers.slice(0, 5), ...(myRank >= 5 ? [town] : [])];
const extraMetrics = ["median_household_income", "vacancy_rate", "poverty_rate", "pre1940_share", "broadband_subscription_share", "under_18_share", "nrhp_district_count", "drive_min_nearest_hospital", "miles_to_rail_station", "population_change", "zhvi", "zori", "zhvi_change_1y", "zori_change_1y", "permits_per_1k", "permit_rate_change", "county_migration_inflow", "county_migration_outflow", "dri_award_count"];
const provenance = new Map<string, { source: string; period: string; as_of: string; r2_key: string; metrics: string[] }>();
for (const name of [...Object.keys(score?.inputs ?? {}), ...Object.keys(mo?.inputs ?? {}), "median_home_value", "median_gross_rent", "drive_min_nyc", "osm_business_count", "permit_units", ...extraMetrics]) {
  const e = m(name);
  if (!e) continue;
  const key = e.r2_key;
  const p = provenance.get(key) ?? { source: sourceById.get(e.source_id)?.name ?? e.source_id, period: e.period, as_of: e.as_of, r2_key: key, metrics: [] };
  if (!p.metrics.includes(label(name))) p.metrics.push(label(name));
  provenance.set(key, p);
}
const popChange = m("population_change");
const popText = usable(popChange) ? `${popChange.value >= 0 ? "" : ""}${formatValue("population_change", popChange.value)} since 2020` : null;
const metro = m("metro_median_home_value");
const hub = m("drive_min_regional_hub");
const perK = m("osm_business_per_1k");
const permitRate = m("permits_per_1k");
const zillowRent = m("zori");
const usage = mo ? momentumUsage(mo) : null;
const title = townTitle(town);
const description = townDescription(town);
const summary = townSummary(town);
const facts = townFacts(town);
const crumbs = [
  { name: "All towns", path: "/towns" },
  { name: `${town.region} towns`, path: regionPath(town.region) },
  { name: `${town.county} County`, path: countyPath(town.county) },
  { name: `${town.name}, NY`, path: `/town/${town.slug}` },
];
---
<Base title={title} description={description} jsonLd={placeLd(town)} crumbs={crumbs}>
  <section class="band">
    <div class="wrap hero-grid town">
        <div>
          <p class="small" style="margin:0 0 .4rem"><a class="quiet" href="/towns">All towns</a> › <a class="quiet" href={regionPath(town.region)}>{town.region}</a> › <a class="quiet" href={countyPath(town.county)}>{town.county} County</a></p>
          <h1 style="margin:0">{town.name} <span class="pill">{town.legal_type}</span></h1>
          <p class="muted" style="margin:.5rem 0 .3rem">Population {population(town.pop_latest)} ({town.pop_latest_year}){popText ? ` · ${popText}` : ""} · graded against towns {band(town)}</p>
          <p class="eyebrow" style="margin:0">GEOID {town.geoid} · {town.lat.toFixed(3)}, {town.lon.toFixed(3)}</p>
        </div>
        <div class="scores">
          <div class="panel score-card">
            <div class="head"><span class="eyebrow">Readiness · are the ingredients there?</span><span class="eyebrow">coverage {pct(score?.coverage)}</span></div>
            <div class="main">
              <Grade grade={score?.grade ?? null} big />
              <div><div class="num">{score1(score?.readiness)}<small> / 100</small></div><span class="small muted">{score?.grade ? `rank within the ${band(town)} band` : score ? "coverage below the floor, so no grade" : "not scored"}</span></div>
            </div>
            {score && <p>{readinessMeaning(score, town)}{!score.grade && <> <a href="/methodology#coverage">Why no grade?</a></>}</p>}
          </div>
          <div class="panel score-card">
            <div class="head"><span class="eyebrow">Momentum · is anything happening?</span><span class="eyebrow">{usage ? `${usage.used} of ${usage.total} inputs` : ""}</span></div>
            <div class="main">
              <Momentum m={mo} big />
              <div><div class="num">{score1(mo?.momentum)}<small> / 100</small></div><span class="small muted">50 is keeping pace · rising at {methodology.momentum.grading.bands.rising}</span></div>
            </div>
            {mo && <p>{momentumMeaning(mo)}{!mo.label && <> <a href="/methodology#momentum-coverage">Why no label?</a></>}{mo.label === "fading" && <> <span class="muted">Fading means behind the New York benchmarks on these inputs over the periods shown, nothing more.</span></>}</p>}
          </div>
        </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cards five" style="margin-top:.5rem">
      <Figure name="median_home_value" entry={m("median_home_value")} note={usable(metro) ? `metro ${formatValue("metro_median_home_value", metro.value)}` : undefined} />
      <Figure name="median_gross_rent" entry={m("median_gross_rent")} note={usable(zillowRent) ? `Zillow ${formatValue("zori", zillowRent.value)}` : "Zillow: not covered"} />
      <Figure name="drive_min_nyc" entry={m("drive_min_nyc")} label="Drive to New York City" note={usable(hub) ? `nearest hub ${formatValue("drive_min_regional_hub", hub.value)}` : undefined} />
      <Figure name="osm_business_count" entry={m("osm_business_count")} note={usable(perK) ? `${formatValue("osm_business_per_1k", perK.value)}` : undefined} />
      <Figure name="permit_units" entry={m("permit_units")} note={usable(permitRate) ? `${formatValue("permits_per_1k", permitRate.value)} a year, 3-yr mean` : undefined} />
    </div>

    <section class="answer">
      <h2>Is {town.name}, NY a good place to live or invest in?</h2>
      <p class="lede" style="max-width:none">{summary.join(" ")}</p>
      <p class="small muted">Written from the figures below, not by hand. {meta.site.SITE_NAME} sells nothing and takes no listings; a grade ranks a town against others of its size, and a momentum label is direction, not a forecast. None of it is financial, investment or relocation advice: check the cited source before acting on a figure. <a href="/methodology">How the scores work</a> · <a href="/about#not">what this site is not</a>.</p>
      <h3 id="facts">Key facts, each with its period and source</h3>
      <dl class="facts">
        {facts.map((f) => <div><dt>{f.label}</dt><dd><span class="mono">{f.value}</span><span class="meta">{f.period} · {f.source}</span></dd></div>)}
      </dl>
    </section>

    <div class="split">
      <section>
        <div class="row-between"><h2>Readiness: six factors</h2><span class="muted small">mean of usable inputs · weighted sum · <a href="/methodology#curves">every curve</a></span></div>
        {score ? methodology.factors.map((f, i) => <FactorCard factor={f.name} weight={f.weight} score={score} inputs={f.inputs} open={i === 0} />) : <p class="notice">This town has not been scored yet.</p>}
      </section>
      <section>
        <div class="row-between"><h2>Momentum: against a benchmark</h2><span class="muted small">{methodology.momentum.version} · <a href="/methodology#momentum">how</a></span></div>
        {mo ? methodology.momentum.factors.map((f) => <FactorCard factor={f.name} weight={f.weight} score={mo} inputs={f.inputs} tone="momentum" />) : <p class="notice">This town has no momentum score yet.</p>}
        {mo && Object.values(mo.factor_scores).some((v) => v === null) && <p class="notice"><span class="mono">NOTE</span>Momentum is renormalised over the factors that have data, so this score rests on fewer than all of them. Coverage is shown wherever the score is.</p>}
      </section>
    </div>

    <h2>More figures</h2>
    <div class="cards" style="grid-template-columns:repeat(auto-fill,minmax(10rem,1fr))">
      {extraMetrics.filter((n) => m(n)).map((n) => <Figure name={n} entry={m(n)} />)}
    </div>

    <div class="row-between"><h2>Peers: {town.region} towns {band(town)}</h2><a class="small" href={`/compare?towns=${[town.slug, ...peers.filter((t) => t.geoid !== town.geoid).slice(0, 2).map((t) => t.slug)].join(",")}`}>Compare with the two nearest →</a></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Town</th><th class="num">Pop.</th><th>Grade</th><th class="num">Readiness</th><th>Momentum</th><th class="num">Home value</th><th class="num">To NYC</th></tr></thead>
        <tbody>
          {peerRows.map((t) => (
            <tr class={t.geoid === town.geoid ? "me" : ""}>
              <td class="mono muted">{peers.findIndex((p) => p.geoid === t.geoid) + 1}</td>
              <td>{t.geoid === town.geoid ? <strong>{t.name}</strong> : <a class="town" href={`/town/${t.slug}`}>{t.name}</a>} <span class="sub">{t.county}{t.geoid === town.geoid ? " · this town" : ""}</span></td>
              <td class="num">{population(t.pop_latest)}</td>
              <td><Grade grade={scores[t.geoid].grade} /></td>
              <td class="num">{score1(scores[t.geoid].readiness)}</td>
              <td><Momentum m={momentum[t.geoid]} /></td>
              <td class="num">{(() => { const e = metric(t.geoid, "median_home_value"); return usable(e) ? formatValue("median_home_value", e.value) : "n/a"; })()}</td>
              <td class="num">{(() => { const e = metric(t.geoid, "drive_min_nyc"); return usable(e) ? formatValue("drive_min_nyc", e.value) : "n/a"; })()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="row-between"><h2 id="sources">Sources for this page</h2><span class="muted small">the key is the exact snapshot in our archive</span></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Source</th><th>Period</th><th>Pulled</th><th>Figures</th><th>Snapshot</th></tr></thead>
        <tbody>
          {[...provenance.values()].sort((a, b) => a.source.localeCompare(b.source)).map((p) => (
            <tr><td>{p.source}</td><td class="mono">{p.period}</td><td class="mono">{p.as_of}</td><td class="small muted">{p.metrics.join(", ")}</td><td class="mono muted" style="word-break:break-all">{p.r2_key}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Readiness computed {score?.computed_at?.slice(0, 10)} with methodology {score?.config_version}{mo ? `; momentum computed ${mo.computed_at.slice(0, 10)} with momentum methodology ${mo.config_version}` : ""}. Something wrong? <a href="/about#corrections">Send a correction</a>.</p>
  </div>
</Base>
