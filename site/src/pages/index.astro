---
import Base from "../layouts/Base.astro";
import Grade from "../components/Grade.astro";
import Momentum from "../components/Momentum.astro";
import { bandKey, meta, momentum, scores, towns, usingSampleData } from "../lib/data";
import { score1 } from "../lib/format";

const site = meta.site;
const graded = towns.filter((t) => scores[t.geoid]);
const rising = towns.filter((t) => momentum[t.geoid]?.label === "rising").sort((a, b) => momentum[b.geoid].momentum - momentum[a.geoid].momentum).slice(0, 8);
const labelCounts = ["rising", "steady", "fading"].map((l) => [l, towns.filter((t) => momentum[t.geoid]?.label === l).length] as const);
const top = (key: "small" | "large") =>
  graded.filter((t) => bandKey(t) === key).sort((a, b) => scores[b.geoid].readiness - scores[a.geoid].readiness).slice(0, 8);
const regions = [...new Set(towns.map((t) => t.region))].sort();
---

<Base>
  <h1>Which New York towns are ready for a comeback?</h1>
  <p class="lede">
    {site.SITE_NAME} grades {meta.town_count} cities and villages in the Hudson Valley, Capital Region and Mohawk Valley on one
    question: are the ingredients for a revival present? Access, building stock, main street, price headroom, services and
    civic capacity, each from public data, each figure with its source and date. A second score, momentum, asks whether
    anything is actually happening yet: home values, permits, population and migration, each against a benchmark.
  </p>
  {usingSampleData && <p class="notice">This build uses the sample fixture: only {meta.town_count} towns are shown.</p>}

  <form class="search" action="/towns" method="get" id="find">
    <label for="q" class="muted">Find a town</label>
    <input id="q" name="q" type="search" list="town-names" placeholder="Catskill, Hudson, Little Falls…" autocomplete="off" />
    <datalist id="town-names">{towns.map((t) => <option value={t.name} data-slug={t.slug}>{t.county} County</option>)}</datalist>
    <button type="submit">Go</button>
  </form>
  <ul id="hits" class="plain" hidden></ul>
  <script is:inline>
    // Progressive enhancement: search-as-you-type against /api/search, with the datalist as
    // the no-JS fallback. Content on this page never depends on it.
    const q = document.getElementById("q");
    const hits = document.getElementById("hits");
    const form = document.getElementById("find");
    let timer = null, last = "";
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const render = (results) => {
      hits.innerHTML = results.map((r) => `<li><a href="/town/${esc(r.slug)}">${esc(r.name)}</a> <span class="muted small">${esc(r.legal_type)}, ${esc(r.county)} County${r.grade ? ` · grade ${esc(r.grade)}` : ""}</span></li>`).join("");
      hits.hidden = results.length === 0;
    };
    q.addEventListener("input", () => {
      clearTimeout(timer);
      const value = q.value.trim();
      if (value.length < 2) { hits.hidden = true; return; }
      timer = setTimeout(async () => {
        last = value;
        try {
          const r = await fetch(`/api/search?q=${encodeURIComponent(value)}&limit=8`);
          if (!r.ok) return;
          const data = await r.json();
          if (data.q === last) render(data.results);
        } catch (_) { /* fall back to the datalist */ }
      }, 120);
    });
    form.addEventListener("submit", (e) => {
      const value = q.value.trim().toLowerCase();
      const opt = [...document.querySelectorAll("#town-names option")].find((o) => o.value.toLowerCase() === value);
      if (opt) { e.preventDefault(); location.href = "/town/" + opt.dataset.slug; return; }
      const first = hits.querySelector("a");
      if (first && !hits.hidden) { e.preventDefault(); location.href = first.getAttribute("href"); }
    });
  </script>

  <div class="two">
    {(["small", "large"] as const).map((key) => (
      <section>
        <h2>{key === "small" ? "Villages and small cities (under 5,000)" : "Cities and larger villages (5,000+)"}</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Town</th><th>Grade</th><th class="num">Readiness</th></tr></thead>
            <tbody>
              {top(key).map((t) => (
                <tr>
                  <td><a href={`/town/${t.slug}`}>{t.name}</a> <span class="muted small">{t.county}</span></td>
                  <td><Grade grade={scores[t.geoid].grade} /></td>
                  <td class="num">{score1(scores[t.geoid].readiness)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small"><a href="/rankings/highest-readiness">Full ranking →</a></p>
      </section>
    ))}
  </div>

  <h2>Rising now</h2>
  <p class="muted small">Towns whose momentum score is 60 or more: {labelCounts.map(([l, n]) => `${n} ${l}`).join(" · ")}. A town keeping pace with the typical New York place scores 50.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Town</th><th>Momentum</th><th class="num">Score</th><th>Grade</th><th class="num">Readiness</th></tr></thead>
      <tbody>
        {rising.map((t) => (
          <tr>
            <td><a href={`/town/${t.slug}`}>{t.name}</a> <span class="muted small">{t.county}</span></td>
            <td><Momentum label={momentum[t.geoid].label} /></td>
            <td class="num">{score1(momentum[t.geoid].momentum)}</td>
            <td><Grade grade={scores[t.geoid]?.grade ?? null} /></td>
            <td class="num">{score1(scores[t.geoid]?.readiness)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small"><a href="/rankings/strongest-momentum">Full momentum ranking →</a></p>

  <h2>Rankings</h2>
  <ul>
    <li><a href="/rankings/highest-readiness">Highest readiness</a></li>
    <li><a href="/rankings/strongest-momentum">Strongest momentum</a></li>
    <li><a href="/rankings/price-headroom">Best price headroom</a></li>
    <li><a href="/rankings/value-within-an-hour">Best value within an hour of a city</a></li>
  </ul>

  <h2>What this is not</h2>
  <p>
    A readiness grade says the ingredients are there. The momentum label says whether anything is happening yet, from four
    public series; it is not a forecast, and its migration input is a county figure. Every competitor sells the town. This
    site also says when one is stalling, which only works if every number carries its source, so
    <a href="/methodology">the methodology</a> is written for a town official to argue with.
  </p>
  <p class="muted small">Regions covered: {regions.join(", ")}. Missing figures are shown as missing, never as zero.</p>
</Base>
