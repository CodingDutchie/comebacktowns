---
import Base from "../layouts/Base.astro";
import Grade from "../components/Grade.astro";
import { scores, towns } from "../lib/data";
import { population, score1 } from "../lib/format";

const byRegion = new Map<string, typeof towns>();
for (const t of [...towns].sort((a, b) => a.name.localeCompare(b.name))) {
  byRegion.set(t.region, [...(byRegion.get(t.region) ?? []), t]);
}
---
<Base title="All towns" description="Every city and village in scope, by region.">
  <h1>All towns</h1>
  <p class="lede">{towns.length} cities and villages, grouped by region. Search results land here when a name does not match exactly.</p>
  {[...byRegion.entries()].sort().map(([region, list]) => (
    <section>
      <h2>{region}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Town</th><th>County</th><th class="num">Population</th><th>Grade</th><th class="num">Readiness</th></tr></thead>
          <tbody>
            {list.map((t) => (
              <tr>
                <td><a href={`/town/${t.slug}`}>{t.name}</a> <span class="muted small">{t.legal_type}</span></td>
                <td>{t.county}</td>
                <td class="num">{population(t.pop_latest)}</td>
                <td><Grade grade={scores[t.geoid]?.grade ?? null} /></td>
                <td class="num">{score1(scores[t.geoid]?.readiness)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>
